[
  {
    "id": "tab_temp",
    "type": "tab",
    "label": "SenseHAT 온도 대시보드",
    "disabled": false,
    "info": "SenseHAT의 온도·습도·기압을 5초마다 읽어 대시보드에 보여 준다.\n대시보드 주소: http://<라즈베리파이 주소>:1880/dashboard"
  },
  {
    "id": "ui_base",
    "type": "ui-base",
    "name": "SenseHAT",
    "path": "/dashboard",
    "includeClientData": true,
    "acceptsClientConfig": [
      "ui-notification",
      "ui-control"
    ],
    "showPathInSidebar": false,
    "navigationStyle": "default"
  },
  {
    "id": "ui_theme",
    "type": "ui-theme",
    "name": "SenseHAT 테마",
    "colors": {
      "surface": "#c51a4a",
      "primary": "#c51a4a",
      "bgPage": "#eeeeee",
      "groupBg": "#ffffff",
      "groupOutline": "#cccccc"
    },
    "sizes": {
      "pagePadding": "12px",
      "groupGap": "12px",
      "groupBorderRadius": "8px",
      "widgetGap": "12px"
    }
  },
  {
    "id": "ui_page",
    "type": "ui-page",
    "name": "온도",
    "ui": "ui_base",
    "path": "/temp",
    "icon": "thermometer",
    "layout": "grid",
    "theme": "ui_theme",
    "order": 1,
    "className": "",
    "visible": "true",
    "disabled": "false"
  },
  {
    "id": "ui_group",
    "type": "ui-group",
    "name": "SenseHAT 환경 센서",
    "page": "ui_page",
    "width": "6",
    "height": "1",
    "order": 1,
    "showTitle": true,
    "className": "",
    "visible": "true",
    "disabled": "false"
  },
  {
    "id": "note",
    "type": "comment",
    "z": "tab_temp",
    "name": "SenseHAT 값 → 5초에 한 번 → 온도·습도·기압으로 나눠 화면에 표시",
    "info": "온도는 라즈베리파이 CPU 열 때문에 실제 방 온도보다 5~15℃ 높게 나옵니다.\n'값 나누기' 노드에서 보정값을 빼 보세요.",
    "x": 330,
    "y": 60,
    "wires": []
  },
  {
    "id": "sense_in",
    "type": "rpi-sensehat in",
    "z": "tab_temp",
    "name": "SenseHAT 센서",
    "motion": false,
    "env": true,
    "stick": false,
    "x": 120,
    "y": 140,
    "wires": [
      [
        "rate"
      ]
    ]
  },
  {
    "id": "rate",
    "type": "delay",
    "z": "tab_temp",
    "name": "5초에 한 번만",
    "pauseType": "rate",
    "timeout": "5",
    "timeoutUnits": "seconds",
    "rate": "1",
    "nbRateUnits": "5",
    "rateUnits": "second",
    "randomFirst": "1",
    "randomLast": "5",
    "randomUnits": "seconds",
    "drop": true,
    "allowrate": false,
    "outputs": 1,
    "x": 300,
    "y": 140,
    "wires": [
      [
        "split"
      ]
    ]
  },
  {
    "id": "split",
    "type": "function",
    "z": "tab_temp",
    "name": "값 나누기",
    "outputs": 3,
    "func": "// SenseHAT이 보내는 값: msg.payload = { temperature, humidity, pressure }\nconst e = msg.payload;\nconst 보정 = 0;   // 예: CPU 열 때문에 10℃ 높게 나오면 10\nreturn [\n    { payload: Math.round((e.temperature - 보정) * 10) / 10, topic: \"온도\" },  // 1번 출구: 온도(℃)\n    { payload: Math.round(e.humidity) },                                   // 2번 출구: 습도(%)\n    { payload: Math.round(e.pressure) }                                    // 3번 출구: 기압(hPa)\n];",
    "outputLabels": [
      "온도",
      "습도",
      "기압"
    ],
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 140,
    "wires": [
      [
        "gauge",
        "chart"
      ],
      [
        "hum"
      ],
      [
        "pres"
      ]
    ]
  },
  {
    "id": "gauge",
    "type": "ui-gauge",
    "z": "tab_temp",
    "name": "온도 게이지",
    "group": "ui_group",
