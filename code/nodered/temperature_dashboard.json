    "width": 3,
    "height": 3,
    "gtype": "gauge-half",
    "gstyle": "needle",
    "title": "온도",
    "units": "℃",
    "icon": "",
    "prefix": "",
    "suffix": "",
    "segments": [
      {
        "from": "0",
